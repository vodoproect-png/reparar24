# Reparar24 Environment Variables
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://reparar24.es
NEXT_PUBLIC_SITE_NAME=Reparar24

# Contact Information
NEXT_PUBLIC_PHONE=+34XXXXXXXXX
NEXT_PUBLIC_EMAIL=info@reparar24.es
NEXT_PUBLIC_WHATSAPP=34XXXXXXXXX

# Analytics
# Production IDs - Add to .env.local
NEXT_PUBLIC_GA4_ID=G-PGM6VFMXRW
NEXT_PUBLIC_GTM_ID=GT-5NRMZRTD
# Google Ads conversion tracking. Public IDs are safe for the browser.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_SEND_TO=AW-XXXXXXXXXX/XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_PHONE_SEND_TO=AW-XXXXXXXXXX/XXXXXXXXXX

# AI SEO Factory - KeywordInsights API
# Get your API key from: https://www.keywordinsights.ai/
KEYWORDINSIGHTS_API_KEY=your_api_key_here

# Ahrefs API
# Get your API key from: https://app.ahrefs.com/account/api-keys
# Keep real keys only in .env.local, never commit them.
AHREFS_API_KEY=
AHREFS_COUNTRY=es

# DataForSEO API
# Google Ads-backed keyword suggestions fallback.
# Get credentials from: https://app.dataforseo.com/api-access
# Keep real credentials only in .env.local, never commit them.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Ads API
# Official Google keyword source. Live adapter requires OAuth transport setup.
# Keep real credentials only in .env.local, never commit them.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional if using a manager account. Use digits only or with dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional for campaign creation when GOOGLE_ADS_CUSTOMER_ID is a manager account.
# Must be a non-manager Google Ads client account.
GOOGLE_ADS_ADVERTISING_CUSTOMER_ID=
# Optional API version override. Default in scripts: v20.
GOOGLE_ADS_API_VERSION=v25

# v0 Platform API
# Get your API key from: https://v0.app/settings
# Requires a v0 Premium or Team plan.
# Keep real keys only in .env.local, never commit them.
V0_API_KEY=

# BuzzStream API
# Get OAuth consumer credentials from BuzzStream API settings.
# Keep real credentials only in .env.local, never commit them.
BUZZSTREAM_CONSUMER_KEY=
BUZZSTREAM_CONSUMER_SECRET=
BUZZSTREAM_API_BASE_URL=https://api.buzzstream.com/v1

# Copyscape Premium API
# Used for external plagiarism/originality checks before blog publishing and for commercial page audits.
# Get credentials from: https://www.copyscape.com/api-guide.php
# Keep real credentials only in .env.local, never commit them.
COPYSCAPE_USERNAME=
COPYSCAPE_API_KEY=
COPYSCAPE_API_URL=https://www.copyscape.com/api/
# 0 means strict 100% uniqueness target. Raise only if we deliberately allow minor boilerplate matches.
COPYSCAPE_MAX_PERCENT_MATCHED=0
COPYSCAPE_FULL_COMPARISONS=3
COPYSCAPE_IGNORE_DOMAINS=reparar24.es,www.reparar24.es

# Text.ru API
# Experimental external uniqueness + SEO text metrics provider.
# Keep real credentials only in .env.local, never commit them.
TEXT_RU_API_KEY=
TEXT_RU_API_URL=https://api.text.ru/post
# Polling is used because Text.ru checks are asynchronous.
TEXT_RU_POLL_ATTEMPTS=10
TEXT_RU_POLL_DELAY_MS=8000
# 100 means strict uniqueness target for articles/pages we publish.
TEXT_RU_MIN_UNIQUENESS=100
TEXT_RU_MAX_WATER_PERCENT=1
# Text.ru spam metric is strict for Spanish text; current calibrated normal range is 74-76.
TEXT_RU_MAX_SPAM_PERCENT=80

# Google Business Profile API
# Requires Google approval for GBP APIs. Keep real credentials only in .env.local.
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_API_VERSION=v1
